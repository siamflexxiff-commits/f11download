rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Global statistics rules
    match /stats/global {
      allow read: if true;
      
      // Allow incrementing downloading values
      allow create: if (
        isSignedIn() &&
        incoming().downloads is int &&
        incoming().downloads >= 0 &&
        incoming().activeUsers is int &&
        incoming().activeUsers >= 0 &&
        incoming().keys().hasAll(['downloads', 'activeUsers']) &&
        incoming().keys().size() == 2
      );
      
      allow update: if (
        isSignedIn() &&
        incoming().downloads is int &&
        incoming().activeUsers is int &&
        (
          // Action 1: Increment downloads
          (incoming().downloads == existing().downloads + 1 && incoming().diff(existing()).affectedKeys().hasOnly(['downloads'])) ||
          // Action 2: Update active users (for server / admin updates)
          (incoming().diff(existing()).affectedKeys().hasOnly(['activeUsers']))
        )
      );
    }

    // 2. Individual session heartbeat rules
    match /sessions/{sessionId} {
      allow get: if (isSignedIn() && sessionId == request.auth.uid && isValidId(sessionId));
      
      allow create, update: if (
        isSignedIn() &&
        sessionId == request.auth.uid &&
        isValidId(sessionId) &&
        incoming().lastSeen is timestamp &&
        incoming().lastSeen == request.time &&
        incoming().keys().hasAll(['lastSeen']) &&
        incoming().keys().size() == 1
      );

      allow delete: if (
        isSignedIn() &&
        sessionId == request.auth.uid &&
        isValidId(sessionId)
      );
    }
  }
}
